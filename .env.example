# Public services endpoint and the organisation slug to load services for
VITE_SERVICES_API_URL=https://api-prod.lightbasemr.com/public-services
VITE_ORG_SLUG=darlez

# Server only: never prefix these with VITE_. Use sandbox credentials only.
CROSSPOINT_ACCESS_TOKEN=
PAYMENT_SESSION_SECRET=
APP_ORIGIN=http://localhost:3000
SERVICES_API_URL=https://api-prod.lightbasemr.com/public-services
ORG_SLUG=darlez

# Local development only: deployed Vercel hostname with the published hnb-checkout-create firewall rule.
# Hostname only, no scheme or path. Missing protection blocks checkout creation with 503.
CHECKOUT_FIREWALL_HOST=
